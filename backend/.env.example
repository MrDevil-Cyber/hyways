NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://hyway:hyway_dev_password@localhost:5432/hyway?schema=public
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=hyway-api
JWT_AUDIENCE=hyway-mobile
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ADMIN_EMAIL=admin@hyway.local
ADMIN_PASSWORD=ChangeMe123!

# Email via Resend: customer confirmation + HYWAY service-team alert.
RESEND_API_KEY=
EMAIL_FROM=HYWAY Service <service@your-domain.com>
SERVICE_TEAM_EMAILS=service-team@your-domain.com

# WhatsApp Business Cloud API: HYWAY service-team alert.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SERVICE_TEAM_WHATSAPP_NUMBERS=919999999999
# An approved Meta WhatsApp template with six body variables:
# request ID, customer, machine, service, urgency, issue description.
WHATSAPP_SERVICE_TEMPLATE=new_service_request
