generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUOTED
  CLOSED
}

enum ServiceType {
  REPAIR
  MAINTENANCE
  INSTALLATION
  INSPECTION
  CONSULTATION
}

enum ServiceUrgency {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ServiceRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MachineScanStatus {
  SUBMITTED
  PROCESSING
  COMPLETED
  NEEDS_REVIEW
}

enum MeasurementUnit {
  MM
  FT
}

enum SpaceFitStatus {
  PRELIMINARY_FIT
  LIMITED_FIT
  NOT_FEASIBLE
  EXPERT_REVIEW_REQUIRED
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  passwordHash     String
  role             Role              @default(CUSTOMER)
  refreshTokenHash String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  inquiries        Inquiry[]
  customerMachines CustomerMachine[]
  serviceRequests  ServiceRequest[]
  machineScans     MachineScan[]
  spaceAssessments SpaceAssessment[]
  sessions         AuthSession[]
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Product {
  id               String            @id @default(cuid())
  slug             String            @unique
  name             String
  shortDescription String
  description      String
  icon             String
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  images           ProductImage[]
  inquiries        Inquiry[]
  customerMachines CustomerMachine[]
  serviceRequests  ServiceRequest[]
  machineScans     MachineScan[]
  spaceAssessments SpaceAssessment[]

  @@index([isActive, sortOrder])
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  altText   String
  sortOrder Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String
  company   String?
  message   String
  status    InquiryStatus @default(NEW)
  productId String?
  product   Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([productId])
}

model CustomerMachine {
  id              String           @id @default(cuid())
  name            String
  category        String
  serialNumber    String?
  site            String?
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  serviceRequests ServiceRequest[]
  scans           MachineScan[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([userId, serialNumber])
  @@index([productId])
}

model ServiceRequest {
  id                String               @id @default(cuid())
  machineName       String
  machineCategory   String
  serviceType       ServiceType
  issueDescription  String
  urgency           ServiceUrgency       @default(NORMAL)
  status            ServiceRequestStatus @default(SUBMITTED)
  preferredVisitAt  DateTime?
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  customerMachineId String?
  customerMachine   CustomerMachine?     @relation(fields: [customerMachineId], references: [id], onDelete: SetNull)
  scans             MachineScan[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([productId])
  @@index([customerMachineId])
}

model MachineScan {
  id                String            @id @default(cuid())
  serialNumber      String?
  machineName       String?
  notes             String?
  status            MachineScanStatus @default(SUBMITTED)
  resultSummary     String?
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  customerMachineId String?
  customerMachine   CustomerMachine?  @relation(fields: [customerMachineId], references: [id], onDelete: SetNull)
  serviceRequestId  String?
  serviceRequest    ServiceRequest?   @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([productId])
  @@index([customerMachineId])
  @@index([serviceRequestId])
}

model SpaceAssessment {
  id                       String          @id @default(cuid())
  inputUnit                MeasurementUnit
  inputLength              Float
  inputWidth               Float
  inputHeight              Float
  inputEntryWidth          Float?
  inputEntryHeight         Float?
  lengthMm                 Int
  widthMm                  Int
  heightMm                 Int
  entryWidthMm             Int?
  entryHeightMm            Int?
  machineCategory          String?
  material                 String?
  throughputPerHour        Int?
  fitStatus                SpaceFitStatus
  recommendedCategory      String
  recommendedMachineType   String
  recommendedMaxLengthMm   Int
  recommendedMaxWidthMm    Int
  recommendedMaxHeightMm   Int
  recommendationSummary    String
  recommendationDisclaimer String
  userId                   String
  user                     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId                String?
  product                  Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@index([userId, createdAt])
  @@index([userId, fitStatus])
  @@index([productId])
}
